{
  "name": "disklordz-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "sync:ops": "node scripts/sync-ops-snapshot.mjs",
    "sync:intelligence": "node scripts/sync-intelligence-snapshot.mjs",
    "sync:all": "npm run sync:ops && npm run sync:intelligence",
    "prebuild": "npm run sync:ops || true && npm run sync:intelligence || true"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "yaml": "^2.8.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.7.2",
    "vite": "^6.0.3",
    "vite-plugin-pwa": "^0.21.1"
  }
}