# Copy to config/etsy-store.yaml and edit for your shop

niche: "business tools, AI agents sold as outcomes, marketing systems"
product_type: digital
positioning: "Outcomes over features — ready-to-use digital systems for founders"
buyer: "solopreneurs, SMB owners, agency operators"
price_band_usd: "9.99-79.99"
brand_voice: "professional, direct, operator-minded"
fulfillment: instant_download
catalog_focus:
  - excel templates and dashboards
  - web apps, PWAs, command centers
  - AI agent kits and prompt libraries
  - marketing systems and copy templates
  - postcard direct-mail design packs
  - business-in-a-box bundles
marketing_channels:
  - pinterest
  - linkedin
  - instagram
automation:
  # Create Etsy drafts only when true (requires OAuth + taxonomy id)
  publish_drafts: false
  # Run listing + social daily; research weekly (set in n8n cron)
  daily_new_listing: true
