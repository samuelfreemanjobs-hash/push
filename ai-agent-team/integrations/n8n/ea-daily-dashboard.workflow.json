{
  "name": "ea-daily-dashboard",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * 1-5"
            }
          ]
        }
      },
      "id": "cron-weekday-7am",
      "name": "Weekday 7 AM ET",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300],
      "notes": "Adjust cron to your timezone. 7 AM America/New_York ≈ 0 7 * * 1-5 if n8n TZ is ET."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.RAILWAY_API_URL }}/api/webhooks/n8n/ea-daily",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-n8n-secret",
              "value": "={{ $env.N8N_WEBHOOK_SECRET }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={ \"source\": \"n8n\", \"workflow\": \"ea-daily-dashboard\" }",
        "options": {}
      },
      "id": "http-ea-daily",
      "name": "POST push runtime ea-daily",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [520, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "slack-posted-check",
              "leftValue": "={{ $json.slack.posted }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-slack-posted",
      "name": "Slack posted?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [760, 300]
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_EA_CHANNEL || '#executive-assistant' }}",
        "text": "=✅ Daily dashboard posted ({{ $json.dashboardId }})",
        "otherOptions": {}
      },
      "id": "slack-confirm",
      "name": "Slack confirm (optional)",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1020, 220],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      },
      "disabled": true,
      "notes": "Optional. Runtime posts via SLACK_WEBHOOK_URL. Enable if you want n8n confirmation."
    },
    {
      "parameters": {
        "channel": "={{ $env.SLACK_EA_CHANNEL || '#executive-assistant' }}",
        "text": "=⚠️ EA daily run failed to post to Slack. Check push runtime SLACK_WEBHOOK_URL.\n{{ $json.slack.reason || '' }}",
        "otherOptions": {}
      },
      "id": "slack-fail",
      "name": "Slack failure alert",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1020, 400],
      "credentials": {
        "slackApi": {
          "id": "REPLACE_WITH_SLACK_CREDENTIAL_ID",
          "name": "Slack account"
        }
      },
      "disabled": true
    }
  ],
  "connections": {
    "Weekday 7 AM ET": {
      "main": [[{ "node": "POST push runtime ea-daily", "type": "main", "index": 0 }]]
    },
    "POST push runtime ea-daily": {
      "main": [[{ "node": "Slack posted?", "type": "main", "index": 0 }]]
    },
    "Slack posted?": {
      "main": [
        [{ "node": "Slack confirm (optional)", "type": "main", "index": 0 }],
        [{ "node": "Slack failure alert", "type": "main", "index": 0 }]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": [
    { "name": "ea" },
    { "name": "medflow" },
    { "name": "phase-1" }
  ]
}
