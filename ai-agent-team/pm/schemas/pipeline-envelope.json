{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://push.local/pm/pipeline-envelope.json",
  "title": "ProductManagerPipelineEnvelope",
  "description": "Handoff contract for the 5-agent PM runtime (Planner → Research → Requirements → Prioritization → Output/QA)",
  "type": "object",
  "required": ["mission", "stage", "confidence", "artifacts"],
  "properties": {
    "mission": {
      "type": "object",
      "required": ["problem", "success_metrics", "constraints"],
      "properties": {
        "problem": { "type": "string" },
        "success_metrics": { "type": "array", "items": { "type": "string" } },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "stage": {
      "type": "string",
      "enum": [
        "planner",
        "research",
        "requirements",
        "prioritization",
        "output_qa",
        "complete"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Below 0.7 triggers research refresh per governance rules"
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "research": { "type": "array", "items": { "$ref": "#/$defs/evidenceItem" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
        "backlog": { "type": "array", "items": { "$ref": "#/$defs/backlogItem" } },
        "documents": {
          "type": "object",
          "properties": {
            "prd": { "type": "string" },
            "roadmap": { "type": "object" },
            "go_to_market": { "type": "string" }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "properties": {
        "human_approval_required": { "type": "boolean" },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "evidence_gaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "evidenceItem": {
      "type": "object",
      "required": ["claim", "source", "confidence"],
      "properties": {
        "claim": { "type": "string" },
        "source": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "user_story", "acceptance_criteria"],
      "properties": {
        "id": { "type": "string" },
        "user_story": { "type": "string" },
        "acceptance_criteria": { "type": "array", "items": { "type": "string" } }
      }
    },
    "backlogItem": {
      "type": "object",
      "required": ["id", "title", "priority", "rice_score"],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "priority": { "type": "string", "enum": ["P0", "P1", "P2"] },
        "rice_score": { "type": "number" },
        "dependencies": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
