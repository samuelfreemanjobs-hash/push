# Push runtime (MedFlow)
GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here
SUPABASE_KEY=your_supabase_anon_key_here

# Slack — incoming webhook for #executive-assistant daily posts
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Shared secret between n8n and push runtime
N8N_WEBHOOK_SECRET=generate_a_long_random_string

# Product label on /health
PRIMARY_PRODUCT=medflow

PORT=3000
NODE_ENV=production
