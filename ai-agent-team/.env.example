GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
CODE_MODEL=gemini-2.0-flash
PATCH_MODEL=gemini-2.0-flash
# Optional free local coding (PATCH defaults to Ollama when set):
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
OLLAMA_FORCE_AGENT_IDS=patch,code
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
PORT=3000
NODE_ENV=production
# Optional: one-click ops sync from Command Center (workflow scope on push repo)
GITHUB_DISPATCH_TOKEN=

