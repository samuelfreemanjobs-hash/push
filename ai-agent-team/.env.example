GEMINI_API_KEY=your_gemini_api_key_here
SUPABASE_URL=your_supabase_url_here
SUPABASE_KEY=your_supabase_key_here
PORT=3000
NODE_ENV=production

# Etsy Open API (https://www.etsy.com/developers/)
ETSY_API_KEY=your_etsy_keystring
ETSY_ACCESS_TOKEN=
ETSY_REFRESH_TOKEN=
ETSY_SHOP_ID=
ETSY_REDIRECT_URI=https://your-host/api/etsy/oauth/callback
ETSY_DEFAULT_TAXONOMY_ID=
ETSY_NICHE=minimalist printable planners
ETSY_PRODUCT_TYPE=digital
ETSY_AUTOMATION_SECRET=change_me_for_cron_webhooks

# Optional model overrides
GEMINI_FAST_MODEL=gemini-2.0-flash
GEMINI_CREATIVE_MODEL=gemini-2.0-flash

