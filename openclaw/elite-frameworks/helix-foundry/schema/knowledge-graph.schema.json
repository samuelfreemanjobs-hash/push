{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HelixFoundryGraph",
  "type": "object",
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "title"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "enum": ["spec", "bug", "dsp_ref", "product_doc", "test", "skill"] },
          "title": { "type": "string" },
          "path": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["from", "to", "rel"],
        "properties": {
          "from": { "type": "string" },
          "to": { "type": "string" },
          "rel": { "enum": ["implements", "blocks", "references", "tests", "documents"] }
        }
      }
    }
  }
}