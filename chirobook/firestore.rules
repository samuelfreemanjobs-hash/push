rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Practice owners can read/write their own practice data
    match /practices/{practiceId} {
      allow read: if true; // public for patient booking page
      allow write: if request.auth != null && request.auth.uid == practiceId;

      match /services/{serviceId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == practiceId;
      }
      match /packages/{packageId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == practiceId;
      }
      match /patientPackages/{packageCode} {
        allow read: if true; // patients look up their package code
        allow create: if request.auth != null && request.auth.uid == practiceId;
        allow update: if true; // booking page increments usedVisits
        allow delete: if request.auth != null && request.auth.uid == practiceId;
      }
      match /hours/{doc} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == practiceId;
      }
      match /blockedDates/{dateId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == practiceId;
      }
      match /bookings/{bookingId} {
        allow read: if request.auth != null && request.auth.uid == practiceId;
        allow create: if true; // patients create bookings
        allow update: if request.auth != null && request.auth.uid == practiceId;
        allow delete: if request.auth != null && request.auth.uid == practiceId;
      }
    }
  }
}
