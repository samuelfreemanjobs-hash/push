rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /businesses/{businessId} {
      // Anyone can read business profile (needed for public booking page)
      allow read: if true;
      // Only the authenticated owner can write their own business doc
      allow write: if request.auth != null && request.auth.uid == businessId;

      match /services/{serviceId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == businessId;
      }

      match /bookings/{bookingId} {
        // Only owner can read bookings
        allow read: if request.auth != null && request.auth.uid == businessId;
        // Anyone can create a booking (public booking page)
        allow create: if true;
        // Only owner can update (cancel) or delete
        allow update, delete: if request.auth != null && request.auth.uid == businessId;
      }

      match /blockedDates/{dateId} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == businessId;
      }
    }
  }
}
